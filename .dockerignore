# Build context for the backend image. Anything listed here never reaches a layer — and layers
# are permanent, so user data and secrets must be excluded here, not deleted later in a RUN.

# Secrets — passed at run time via env_file / the host's environment
.env
.env.*
**/.env
**/.env.*

# Runtime state — lives in volumes (Docker) or on the host (venv), never in the image
backend/data/
backend/uploads/
backend/logs/
# Pre-Day 7 locations: a checkout whose runtime state hasn't been moved yet
src/
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log

# Python
**/__pycache__/
**/*.py[cod]
venv/
.venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Not part of the backend image (the frontend has its own context; tests are mounted in dev)
frontend/
node_modules/
backend/tests/
backend/eval/
backend/scripts/
docs/
scripts/
.claude/
*.exe
*.docx
*.pdf

# Tooling / OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
