# Copy to .env (repo root) and fill in the values marked REQUIRED.
#   Copy-Item .env.example .env
# .env is gitignored. Never commit real values; this file holds placeholders only.
#
# The backend reads this file both when run from the venv (cd src; uvicorn main:app) and in
# Docker (compose `env_file`). Inside Docker, docker-compose.yml overrides REDIS_URL,
# SEMANTIC_CACHE_REDIS_URL, TESSERACT_PATH and FRONTEND_URL with container values.

# ---------- REQUIRED: the backend refuses to start without these ----------

# Gemini: LLM, embeddings, topic classifier, concept extractor. Startup makes an embedding call.
GEMINI_API_KEY=your-gemini-api-key

# Signs JWTs and the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Google OAuth (settings validation fails if any is missing, even if you never use Google login)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------- OPTIONAL ----------

# Tavily web search. Missing → web results are silently skipped.
TAVILY_API_KEY=your-tavily-api-key

# Gemini model for answers, session topic tags and concept maps (B9). Default: gemini-3.5-flash-lite.
# Set it only to override; projects that used gemini-2.5-flash-lite before can still roll back to it.
# GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite

# Redis for the query cache and web-result cache. Code default: redis://localhost:6379/0.
# 6380 is the host port docker-compose maps Redis to.
REDIS_URL=redis://localhost:6380/0

# Redis for the semantic answer cache — its own DB. Unset → falls back to REDIS_URL,
# then redis://localhost:6379/1.
SEMANTIC_CACHE_REDIS_URL=redis://localhost:6380/1

# JWT settings. Defaults: HS256, 10080 minutes (7 days).
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=10080

# OAuth redirect targets. Defaults below.
# BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000

# CORS allowlist, comma-separated. Default: localhost:3000, localhost:8000 and the Vercel URL.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (T2, Day 13). Default: SQLite at backend/data/app.db (absolute path, any CWD).
# Postgres needs the psycopg 3 driver prefix (postgresql+psycopg://; a plain postgresql:// is
# refused) and DATABASE_SCHEMA, the schema the role's search_path resolves to. Alembic and the
# app refuse to run if the connection's current_schema() differs.
#   Local compose Postgres (host port 5433), as the rag_app role:
# DATABASE_URL=postgresql+psycopg://rag_app:<RAG_APP_PASSWORD>@localhost:5433/rag
# DATABASE_SCHEMA=rag
#   Supabase, through the Supavisor *session* pooler (IPv4, port 5432). The pooler username is
#   <role>.<project-ref>; the search_path comes from the role, not the URL:
# DATABASE_URL=postgresql+psycopg://rag_staging_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=rag_staging

# Local compose Postgres (docker-compose.yml postgres service). REQUIRED to start it: compose
# refuses to run without both. Read once, when the pgdata volume is first initialised; changing
# them later means recreating that volume. Choose your own; local only.
# POSTGRES_PASSWORD=<choose-a-local-superuser-password>
# RAG_APP_PASSWORD=<choose-a-local-rag_app-password>

# Tesseract binary for OCR (host runs only; Docker sets /usr/bin/tesseract).
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# uvicorn port inside the Docker image (Render sets this). Default 8000.
# PORT=8000

# ---------- FRONTEND (not read from this file) ----------
# CRA reads frontend/.env (dev) and frontend/.env.production (build), not the root .env.
# For `npm start` on the host, create frontend/.env with:
#   REACT_APP_API_URL=http://localhost:8000
#   REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# In Docker, compose sets REACT_APP_API_URL; the Google client ID comes from frontend/.env if
# present (dev) or frontend/.env.production (nginx build).
